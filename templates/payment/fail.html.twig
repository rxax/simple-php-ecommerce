{% extends 'base.html.twig' %}

{% block title %}My order - Webshop{% endblock %}

{% block body %}
    <h2>Cancellation of your order</h2>
    <p>
        Hello {{order.user.Firstname}} {{order.user.lastname}}, <br>
        Your payment for order No. <b>{{order.reference}}</b> was not successful.<br>
    </p>
    <hr>
    <a class="btn btn-outline-success" href="{{ path('order') }}">Retry</a>
{% endblock %}