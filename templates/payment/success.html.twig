{% extends 'base.html.twig' %}

{% block title %}My order - Webshop{% endblock %}

{% block body %}
    <h2>Confirmation of your order</h2>
    <p>
        Hello {{order.user.Firstname}} {{order.user.lastname}}, <br>
        Thank you for your order No. <b>{{order.reference}}</b>.<br>
        A confirmation has been sent to you by email. <br>
    </p>
    <hr>
    <p>
        Your order will be delivered by {{order.carrierName}} to the following address: <br>
        {{order.delivery|raw}}
    </p>
    <hr>
    <p>
        To track your order, go to your <a href="{{ path('account_orders') }}">account</a>.
    </p>
{% endblock %}